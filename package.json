{
  "name": "@aoctech/push-client",
  "version": "1.0.0",
  "description": "Web Push for CTech apps: a cache-free service worker plus the subscription client and React hook.",
  "repository": {
    "type": "git",
    "url": "https://github.com/artur-oliveira/ctech-push-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sw.js": "./dist/sw.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-sw.mjs",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && node --check src/sw.js",
    "test": "npm run lint && npm run build && vitest run"
  },
  "keywords": [
    "web-push",
    "service-worker",
    "react",
    "ctech"
  ],
  "author": "Artur Oliveira",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
